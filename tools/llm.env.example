# Copy to tools/llm.env (gitignored). Shell environment variables override these.

# ollama  |  openai
LLM_BACKEND=ollama

# Ollama (default). qwen2.5:14b still works if qwen3 is not pulled.
OLLAMA_MODEL=qwen3:30b-a3b
# Keep the model loaded between turns (first reply after unload is ~9 s slower)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_HOST=http://127.0.0.1:11434

# Switch to GPT-4o mini: set LLM_BACKEND=openai and fill the key.
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o-mini

# After STT utterance end, auto-run LLM + TTS (0 to disable)
ROBOT_AUTO_REPLY=1

# Newest 8 turns go to the LLM verbatim. Older turns are archived on disk
# (.robot-runtime/chat_memory.json) and survive server restarts.
LLM_HISTORY_TURNS=8
# 0 = never expire idle sessions (default). Set e.g. 900 to wipe after 15 min.
LLM_HISTORY_IDLE_S=0
